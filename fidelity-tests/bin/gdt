#!/usr/bin/env bash
# gdt — fidelity-test harness entry point. Subcommands:
#   doctor                      config, account, gdoc, browser
#   validate-fixture DIR        five task fields, baseline files, frozen revision present
#   capture DOC OUTDIR          structure/cat/comments/revisions (screenshots: see gdt-shot)
#   gates FIXTURE_DIR COPY_DOC  source-matches-baseline + precondition hints for a run copy
#   run-start FIXTURE_DIR SLUG [--copy-id ID]   copy (gdoc cp) or adopt a UI-made copy, rename, move to runs/,
#                               gates, before capture; prints the run dir and copy URL
#   run-end RUN_DIR             after capture, revision-later gate, gdt-diff
#   index                       regenerate INDEX.md
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd); root=$(dirname "$here")
cfg="$root/config.yaml"
acct() { grep -E '^account:' "$cfg" | sed 's/^account:[[:space:]]*//' | sed 's/[[:space:]]*#.*//'; }
die() { echo "gdt: $*" >&2; exit 1; }
cmd=${1:-help}; shift || true
case "$cmd" in
  doctor)
    [ -f "$cfg" ] || die "missing $cfg (copy config.example.yaml)"
    A=$(acct); [ -n "$A" ] || die "config.yaml has no account"
    echo "account: $A"; echo "gdoc: $(gdoc --version)"
    gdoc ls --account "$A" "$(grep -E '^drive_root:' "$cfg" | sed 's/^drive_root:[[:space:]]*//;s/[[:space:]]*#.*//')" >/dev/null && echo "drive_root: reachable"
    python3 -c "import json" && echo "python3: ok"
    echo "browser: screenshots need a Chrome session with the claude-in-chrome extension (see references/capture.md)";;
  validate-fixture)
    d=${1:?fixture dir}; ok=1
    for f in fixture.md prompt.md built.md tasks.md baseline/structure.json baseline/cat.md baseline/comments.json baseline/revisions.json baseline/shot.json; do
      [ -e "$d/$f" ] || { echo "missing $d/$f"; ok=0; }; done
    ls "$d"/baseline/view-* >/dev/null 2>&1 || { echo "missing $d/baseline/view-NN"; ok=0; }
    grep -qE '^frozen_revision_id: [0-9]+' "$d/fixture.md" || { echo "fixture.md: frozen_revision_id not set"; ok=0; }
    python3 - "$d/tasks.md" <<'PY' || ok=0
import re,sys
t=open(sys.argv[1]).read(); bad=0
for m in re.finditer(r"^## (\S+)\s*$(.*?)(?=^## |\Z)", t, re.M|re.S):
    missing=[f for f in ("Request","Expected","Target","Allowed","Preconditions") if f"**{f}:**" not in m.group(2)]
    if missing: print(f"task {m.group(1)}: missing {missing}"); bad=1
sys.exit(bad)
PY
    [ $ok = 1 ] && echo "fixture ok: $d" || exit 3;;
  capture)
    doc=${1:?doc}; out=${2:?outdir}; A=$(acct); mkdir -p "$out"
    gdoc structure --account "$A" "$doc" 2>/dev/null > "$out/structure.json"
    gdoc cat --quiet --account "$A" "$doc" > "$out/cat.md" 2>/dev/null
    gdoc comments --all --quiet --account "$A" "$doc" --json > "$out/comments.json" 2>/dev/null
    gdoc revisions --quiet --account "$A" "$doc" --json > "$out/revisions.json" 2>/dev/null
    python3 -c "import json,sys;d=json.load(open('$out/structure.json'));r=json.load(open('$out/revisions.json'))['revisions'];print('docs_revision',d['revisionId']);print('drive_revision',r[-1]['id'],r[-1]['modifiedTime'])"
    echo "captured -> $out (screenshots: gdt-shot)";;
  gates)
    fx=${1:?fixture dir}; copy=${2:?copy doc}; A=$(acct)
    src=$(grep -E '^doc:' "$fx/fixture.md" | sed 's/^doc:[[:space:]]*//')
    tmp=$(mktemp -d)
    gdoc structure --account "$A" "$src" 2>/dev/null > "$tmp/structure.json"
    python3 - "$fx/baseline/structure.json" "$tmp/structure.json" <<'PY'
import json,sys
sys.path.insert(0, __import__('os').path.dirname(__import__('os').path.realpath(sys.argv[0])) if False else '')
def norm(n):
    D={"revisionId","documentId","suggestionsViewMode","commentsViewMode"}
    if isinstance(n,dict): return {k:norm(v) for k,v in n.items() if k not in D}
    if isinstance(n,list): return [norm(v) for v in n]
    return n
a,b=[norm(json.load(open(p))) for p in sys.argv[1:3]]
print("gate source_matches_baseline:", "pass" if a==b else "FAIL (fixture drifted)")
PY
    echo "gate preconditions: check tasks.md preconditions against:"; gdoc comments --all --quiet --account "$A" "$copy" | head -5
    gdoc structure --account "$A" "$copy" 2>/dev/null | python3 -c "import sys,json;s=sys.stdin.read();print({k:s.count(k) for k in ('suggestedInsertionIds','dateElement','footnoteReference','strikethrough')})";;
  run-start)
    fx=${1:?fixture dir}; slug=${2:?slug}; shift 2; copy=""
    while [ $# -gt 0 ]; do case "$1" in --copy-id) copy=$2; shift 2;; *) die "unknown arg $1";; esac; done
    A=$(acct); fx=${fx%/}
    src=$(grep -E '^doc:' "$fx/fixture.md" | sed 's/^doc:[[:space:]]*//')
    runs_folder=$(grep -E '^runs_folder:' "$fx/fixture.md" | sed 's/^runs_folder:[[:space:]]*//')
    [ -n "$runs_folder" ] || die "$fx/fixture.md has no runs_folder:"
    area=$(basename "$(dirname "$fx")"); ver=$(basename "$fx"); date=$(date +%Y%m%d)
    title="gdt-$area-$ver run $date $slug"
    run="$fx/runs/$date-$slug"; n=1; while [ -e "$run/copy_id.txt" ]; do n=$((n+1)); run="$fx/runs/$date-$slug-$n"; done
    mkdir -p "$run"
    if [ -z "$copy" ]; then
      copy=$(gdoc cp --quiet --json --account "$A" "$src" "$title" | python3 -c "import json,sys;print(json.load(sys.stdin)['id'])")
      echo "copy_method: gdoc cp" > "$run/copy_method.txt"
    else
      gdoc rename --quiet --account "$A" "$copy" "$title" >/dev/null
      echo "copy_method: Docs UI (comments+suggestions)" > "$run/copy_method.txt"
    fi
    gdoc mv --account "$A" "$copy" "$runs_folder" >/dev/null
    echo "$copy" > "$run/copy_id.txt"
    "$0" gates "$fx" "$copy" | tee "$run/gates.txt"
    "$0" capture "$copy" "$run/before" | tee -a "$run/gates.txt"
    echo "gdoc_version: $(gdoc --version)" >> "$run/gates.txt"
    echo "run_dir: $run"; echo "copy_url: https://docs.google.com/document/d/$copy/edit";;
  run-end)
    run=${1:?run dir}; run=${run%/}; A=$(acct); copy=$(cat "$run/copy_id.txt")
    fx=$(dirname "$(dirname "$run")")
    slug=$(basename "$run" | sed -E 's/^[0-9]{8}-//'); base=$(echo "$slug" | sed -E 's/-[0-9]+$//')
    grep -q "^## $slug\s*$" "$fx/tasks.md" || slug=$base
    "$0" capture "$copy" "$run/after" | tee -a "$run/gates.txt"
    python3 - "$run" <<'PY2'
import json,sys
run=sys.argv[1]
b=json.load(open(f"{run}/before/revisions.json"))['revisions'][-1]; a=json.load(open(f"{run}/after/revisions.json"))['revisions'][-1]
bd=json.load(open(f"{run}/before/structure.json"))['revisionId']; ad=json.load(open(f"{run}/after/structure.json"))['revisionId']
later = (a['modifiedTime'] > b['modifiedTime']) or (bd != ad)
same = open(f"{run}/before/structure.json").read() == open(f"{run}/after/structure.json").read()
verdict = 'pass' if later else ('n/a (no edit made; structure identical)' if same else 'FAIL (structure differs but no new revision)')
print(f"gate after_revision_later: {verdict}  drive {b['id']}->{a['id']}  docs {bd[:12]}..->{ad[:12]}..")
PY2
    "$here/gdt-diff" "$run/before" "$run/after" --task "$fx/tasks.md#$slug" --out "$run";;
  index) exec python3 "$here/gdt-index";;
  *) sed -n '2,8p' "$0";;
esac
