#!/usr/bin/env python3
"""gdt-diff BEFORE_DIR AFTER_DIR [--task TASKS_MD#slug] [--out DIR]

Structural judge for gdoc fidelity runs. Normalises two `structure.json` dumps, lists
every changed property with a stable semantic path, classifies each item against the
task's Target/Allowed fields (expected | allowed | unexpected), tags visible/invisible,
and diffs cat.md and comments.json. Writes diff.json and diff.md to --out (default:
AFTER_DIR's parent). Exit 0 always; the verdict reads the JSON.

Normalisation policy: see .claude/skills/gdoc-fidelity-test/references/diff.md.
"""
import argparse, difflib, json, re, sys
from pathlib import Path

DROP_KEYS = {"revisionId", "documentId", "suggestionsViewMode", "commentsViewMode",
             "startIndex", "endIndex"}
STYLE_WORDS = {"link": ("link", "url"), "backgroundColor": ("highlight", "background"),
               "foregroundColor": ("colour", "color", "red", "blue"), "bold": ("bold",), "italic": ("italic",),
               "underline": ("underline", "link", "url"), "strikethrough": ("strikethrough", "struck"),
               "fontSize": ("size", "font"), "weightedFontFamily": ("font",), "baselineOffset": ("superscript", "subscript"),
               "smallCaps": ("small caps",)}
PAGINATION_RE = re.compile(r"\.(avoidWidowAndOrphan|keepLinesTogether|keepWithNext)$")
# properties whose change a reader cannot see on the page
INVISIBLE_RE = re.compile(
    r"(listId|namedRangeId|namedRanges|\.link\.|bookmarkId|headingId|objectId|"
    r"anchor|quotedFileContent|namedStyleType|suggestedInsertionIds|suggestedDeletionIds|"
    r"tabId|headerId|footerId|footnoteId|avoidWidowAndOrphan|keepLinesTogether|keepWithNext)")


def load(p):
    return json.loads(Path(p).read_text())


def normalise(node):
    if isinstance(node, dict):
        return {k: normalise(v) for k, v in node.items() if k not in DROP_KEYS}
    if isinstance(node, list):
        return [normalise(v) for v in node]
    return node


def canonicalise(structure):
    """Remove explicit style values that equal the paragraph's named style (Docs stores
    them sometimes and drops them on the next edit; rendering is identical either way)."""
    for tab in structure.get("tabs", []):
        dt = tab.get("documentTab", {})
        named = {st["namedStyleType"]: st for st in dt.get("namedStyles", {}).get("styles", [])}

        def strip(style, base):
            for k in [k for k in style if k != "namedStyleType" and k in base and style[k] == base[k]]:
                del style[k]

        def walk(content):
            for c in content:
                if "paragraph" in c:
                    p = c["paragraph"]
                    ps = p.setdefault("paragraphStyle", {})
                    base = named.get(ps.get("namedStyleType", "NORMAL_TEXT"), {})
                    strip(ps, base.get("paragraphStyle", {}))
                    for e in p.get("elements", []):
                        if "textRun" in e:
                            strip(e["textRun"].setdefault("textStyle", {}), base.get("textStyle", {}))
                    if "bullet" in p:
                        strip(p["bullet"].setdefault("textStyle", {}), base.get("textStyle", {}))
                elif "table" in c:
                    for row in c["table"].get("tableRows", []):
                        for cell in row.get("tableCells", []):
                            walk(cell.get("content", []))
                elif "tableOfContents" in c:
                    walk(c["tableOfContents"].get("content", []))
        walk(dt.get("body", {}).get("content", []))
        for key in ("headers", "footers", "footnotes"):
            for seg in dt.get(key, {}).values():
                walk(seg.get("content", []))
    return structure


def para_text(p):
    out = []
    for e in p.get("elements", []):
        if "textRun" in e:
            out.append(e["textRun"].get("content", ""))
        else:
            kind = next((k for k in e if k not in ("startIndex", "endIndex")), "typelessElement")
            out.append(f"⟨{kind}⟩")
    return "".join(out)


def label(text):
    t = text.replace("\n", "⏎").replace("\t", "⇥")
    return t[:30]


def spans(p):
    """Per-character (char, style-json) list for a paragraph; non-text elements become
    one pseudo-char carrying their kind and properties."""
    out = []
    for e in p.get("elements", []):
        if "textRun" in e:
            tr = e["textRun"]
            st = json.dumps({k: v for k, v in tr.items() if k != "content"}, sort_keys=True, default=str)
            for ch in tr.get("content", ""):
                out.append((ch, st))
        else:
            kind = next((k for k in e if k not in ("startIndex", "endIndex")), "typelessElement")
            out.append((f"⟨{kind}⟩", json.dumps(e.get(kind, {}), sort_keys=True, default=str)))
    return out


def flatten(structure):
    """Return {semantic_path: value}. Paragraph runs are NOT compared by index (run
    boundaries shift on every edit); compare_paragraphs() handles text and style."""
    leaves = {}
    paras = {}   # container prefix -> ordered list of dicts(label, spans, style, bullet)

    def leaf(path, v):
        if isinstance(v, dict):
            if not v:
                leaves[path] = {}
            for k, vv in v.items():
                leaf(f"{path}.{k}", vv)
        elif isinstance(v, list):
            if not v:
                leaves[path] = []
            for i, vv in enumerate(v):
                leaf(f"{path}[{i}]", vv)
        else:
            leaves[path] = v

    def walk_content(content, prefix):
        pn = 0
        tn = 0
        for c in content:
            if "paragraph" in c:
                p = c["paragraph"]
                paras.setdefault(prefix, []).append({
                    "label": label(para_text(p)), "spans": spans(p),
                    "paragraphStyle": p.get("paragraphStyle", {}), "bullet": p.get("bullet", None)})
            elif "table" in c:
                t = c["table"]
                base = f"{prefix}/table[{tn}]"
                tn += 1
                leaf(f"{base}.rows", t.get("rows"))
                leaf(f"{base}.columns", t.get("columns"))
                leaf(f"{base}.tableStyle", t.get("tableStyle", {}))
                for r, row in enumerate(t.get("tableRows", [])):
                    leaf(f"{base}.rowStyle[{r}]", row.get("tableRowStyle", {}))
                    for cc, cell in enumerate(row.get("tableCells", [])):
                        leaf(f"{base}/cell[{r},{cc}].style", cell.get("tableCellStyle", {}))
                        walk_content(cell.get("content", []), f"{base}/cell[{r},{cc}]")
            elif "sectionBreak" in c:
                leaf(f"{prefix}/sectionBreak", c["sectionBreak"])
            elif "tableOfContents" in c:
                walk_content(c["tableOfContents"].get("content", []), f"{prefix}/toc")

    for tab in structure.get("tabs", []):
        title = tab.get("tabProperties", {}).get("title", "?")
        dt = tab.get("documentTab", {})
        prefix = f"tab[{title}]"
        walk_content(dt.get("body", {}).get("content", []), prefix)
        for key in ("headers", "footers", "footnotes"):
            for oid, seg in sorted(dt.get(key, {}).items()):
                walk_content(seg.get("content", []), f"{prefix}/{key}[{oid}]")
        for key in ("lists", "namedRanges", "inlineObjects", "positionedObjects",
                    "documentStyle", "namedStyles"):
            leaf(f"{prefix}/{key}", dt.get(key, {}))
    return leaves, paras


def _leaf_items(path, b, a):
    """Flatten two dict/scalar values under `path` and return changed leaves."""
    def fl(v, pre, out):
        if isinstance(v, dict):
            if not v:
                out[pre] = {}
            for k, vv in v.items():
                fl(vv, f"{pre}.{k}", out)
        elif isinstance(v, list):
            if not v:
                out[pre] = []
            for i, vv in enumerate(v):
                fl(vv, f"{pre}[{i}]", out)
        else:
            out[pre] = v
    lb, la = {}, {}
    fl(b, path, lb); fl(a, path, la)
    return [{"path": k, "before": lb.get(k, "∅"), "after": la.get(k, "∅")}
            for k in sorted(set(lb) | set(la)) if lb.get(k, "∅") != la.get(k, "∅")]


def compare_paragraphs(pb, pa):
    """Align the paragraph sequences of each container with difflib (so an inserted or
    deleted paragraph does not shift everything after it), then for each aligned pair
    align characters. Text edits become `.text` items; style differences on text that
    did NOT change become `.style@"snippet"` items and are always suspicious; inserted
    and deleted paragraphs become `para[new:…]` / `para[del:…]` items carrying their
    bullet and paragraphStyle so the judge can see list membership."""
    items = []
    for prefix in sorted(set(pb) | set(pa)):
        lb, la = pb.get(prefix, []), pa.get(prefix, [])
        tb = ["".join(c for c, _ in p["spans"]) for p in lb]
        ta = ["".join(c for c, _ in p["spans"]) for p in la]
        sm = difflib.SequenceMatcher(a=tb, b=ta, autojunk=False)
        pairs, inserted, deleted = [], [], []
        for tag, i1, i2, j1, j2 in sm.get_opcodes():
            if tag == "equal":
                pairs += [(i, j1 + (i - i1)) for i in range(i1, i2)]
            elif tag == "replace":
                n = min(i2 - i1, j2 - j1)
                # pair the most similar texts first, positionally as a tiebreak
                cand = sorted(((difflib.SequenceMatcher(a=tb[i], b=ta[j], autojunk=False).ratio(), -abs((i - i1) - (j - j1)), i, j)
                               for i in range(i1, i2) for j in range(j1, j2)), reverse=True)
                ui, uj = set(), set()
                for r, _, i, j in cand:
                    if i in ui or j in uj or len(ui) >= n:
                        continue
                    if r < 0.3 and n < (i2 - i1) + (j2 - j1):
                        break
                    ui.add(i); uj.add(j); pairs.append((i, j))
                deleted += [i for i in range(i1, i2) if i not in ui]
                inserted += [j for j in range(j1, j2) if j not in uj]
            elif tag == "delete":
                deleted += list(range(i1, i2))
            elif tag == "insert":
                inserted += list(range(j1, j2))
        for j in inserted:
            p = la[j]
            base = f"{prefix}/para[new@{j}:{p['label']}]"
            items.append({"path": base + ".text", "before": "∅", "after": ta[j].replace("\n", "⏎"), "kind": "text", "after_para_text": ta[j].replace("\n", "")})
            if p["bullet"]:
                items.append({"path": base + ".bullet", "before": "∅", "after": p["bullet"], "kind": "para"})
            items.append({"path": base + ".paragraphStyle", "before": "∅", "after": p["paragraphStyle"], "kind": "para"})
        for i in deleted:
            p = lb[i]
            base = f"{prefix}/para[del@{i}:{p['label']}]"
            items.append({"path": base + ".text", "before": tb[i].replace("\n", "⏎"), "after": "∅", "kind": "text"})
            if p["bullet"]:
                items.append({"path": base + ".bullet", "before": p["bullet"], "after": "∅", "kind": "para"})
        for i, j in sorted(pairs):
            b, a = lb[i], la[j]
            path = f"{prefix}/para[{i}:{b['label']}]"
            start_n = len(items)
            for it in _leaf_items(path + ".paragraphStyle", b["paragraphStyle"], a["paragraphStyle"]):
                it["kind"] = "para"; items.append(it)
            for it in _leaf_items(path + ".bullet", b["bullet"], a["bullet"]):
                it["kind"] = "para"; items.append(it)
            sb, sa = b["spans"], a["spans"]
            cb = [c for c, _ in sb]; ca = [c for c, _ in sa]
            csm = difflib.SequenceMatcher(a=cb, b=ca, autojunk=False)
            for tag, i1, i2, j1, j2 in csm.get_opcodes():
                if tag == "equal":
                    k = i1
                    while k < i2:
                        if sb[k][1] != sa[j1 + (k - i1)][1]:
                            start = k
                            while k < i2 and sb[k][1] != sa[j1 + (k - i1)][1] and \
                                  sb[k][1] == sb[start][1] and sa[j1 + (k - i1)][1] == sa[j1 + (start - i1)][1]:
                                k += 1
                            snippet = "".join(cb[start:k]).replace("\n", "⏎")[:40]
                            items.append({"path": f'{path}.style@"{snippet}"',
                                          "before": json.loads(sb[start][1]), "after": json.loads(sa[j1 + (start - i1)][1]),
                                          "kind": "style"})
                        else:
                            k += 1
                else:
                    items.append({"path": f"{path}.text", "kind": "text",
                                  "before": "".join(cb[i1:i2]).replace("\n", "⏎"),
                                  "after": "".join(ca[j1:j2]).replace("\n", "⏎"),
                                  "after_context": "".join(ca[max(0, j1 - 12):min(len(ca), j2 + 12)]).replace("\n", "")})
            for it in items[start_n:]:
                it["after_para_text"] = ta[j].replace("\n", "")
                m = re.search(r'\.style@"(.*)"$', it["path"])
                if m: it["snippet"] = m.group(1).replace("⏎", "")
    return items


def diff_leaves(before, after):
    items = []
    for path in sorted(set(before) | set(after)):
        b, a = before.get(path, "∅"), after.get(path, "∅")
        if b != a:
            items.append({"path": path, "before": b, "after": a})
    return items


def parse_task(spec):
    """tasks.md#slug -> dict(target=[...substrings], allowed=[...substrings], slug)."""
    if not spec or "#" not in spec:
        return None
    file, slug = spec.split("#", 1)
    text = Path(file).read_text()
    m = re.search(rf"^## {re.escape(slug)}\s*$(.*?)(?=^## |\Z)", text, re.M | re.S)
    if not m:
        sys.exit(f"task {slug} not found in {file}")
    body = m.group(1)

    def field(name):
        fm = re.search(rf"\*\*{name}:\*\*\s*(.*?)(?=\n- \*\*|\Z)", body, re.S)
        return " ".join(fm.group(1).split()) if fm else ""

    return {"slug": slug, "request": field("Request"), "expected": field("Expected"),
            "target": field("Target"), "allowed": field("Allowed"),
            "preconditions": field("Preconditions")}


def target_matcher(task):
    """Small locator language, any number of locators per Target:
    `table N, cell [r,c]` (several cells: `cells [r,c] [r,c]`), ``paragraph beginning `X` ``
    (also ``heading `X` ``, ``new paragraph `X` ``), `footnote`, `header`, `footer`,
    `comment`. Returns predicate(path)->bool."""
    if not task:
        return lambda p: False
    t = task["target"]
    preds = []
    tms = list(re.finditer(r"table (\d+)", t))
    for n, tm in enumerate(tms):
        tn = int(tm.group(1)) - 1
        seg = t[tm.end():tms[n + 1].start() if n + 1 < len(tms) else len(t)]
        cells = re.findall(r"\[(\d+),(\d+)\]", seg)
        if cells:
            for r, cc in cells:
                preds.append(lambda p, tn=tn, r=r, cc=cc: f"/table[{tn}]/cell[{r},{cc}]" in p)
        else:
            preds.append(lambda p, tn=tn: f"/table[{tn}]" in p)
    for pm in re.finditer(r"(?:paragraph beginning|heading|new paragraph|paragraph) `([^`]+)`", t):
        prefix = label(pm.group(1))   # labels are 30 chars; a longer locator must still match
        preds.append(lambda p, prefix=prefix: f":{prefix}" in p and "/para[" in p)
    if "footnote" in t.lower():
        preds.append(lambda p: "/footnotes[" in p)
    if re.search(r"\bheader\b", t.lower()):
        preds.append(lambda p: "/headers[" in p)
    if re.search(r"\bfooter\b", t.lower()):
        preds.append(lambda p: "/footers[" in p)
    if "comment" in t.lower():
        preds.append(lambda p: p.startswith("comments"))
    return lambda p: any(f(p) for f in preds)


def mentions(text, words):
    return any(re.search(r"(?<![a-z])" + re.escape(w) + r"(?:s|es|ed|ing)?(?![a-z])", text) for w in words)


def classify(item, in_target, task):
    p = item["path"]
    allowed = (task or {}).get("allowed", "").lower()
    expected = (task or {}).get("expected", "").lower()
    request = (task or {}).get("request", "").lower()
    # a style change on text the edit did not touch is collateral even inside the target,
    # unless the task itself asks for that kind of style change (a link retarget, a
    # highlight removed): every differing style key must be named in the Request or Allowed
    # (not Expected, which usually says what must stay intact)
    if item.get("kind") == "style":
        if in_target(p):
            b = (item["before"] or {}).get("textStyle", {}); a_ = (item["after"] or {}).get("textStyle", {})
            keys = {k for k in set(b) | set(a_) if b.get(k) != a_.get(k)}
            if keys and all(mentions(request + " " + allowed, STYLE_WORDS.get(k, (k.lower(),))) for k in keys):
                return "expected"
        return "unexpected"
    if p.startswith("revisions") and "revision" in allowed:
        return "allowed"
    if p.startswith("comments") and p.endswith("modifiedTime") and "modifiedtime" in allowed:
        return "allowed"
    if PAGINATION_RE.search(p):
        item["note"] = "pagination hint (avoidWidowAndOrphan/keepLinesTogether/keepWithNext); allowed by default, see CORRECTIONS.md"
        return "allowed"
    if in_target(p):
        if item.get("kind") == "para" and "/para[new@" not in p and "/para[del@" not in p:
            # a paragraph-level property changed inside the target: expected only if the
            # task talks about that kind of change
            prop = p.rsplit(".", 1)[-1].lower()
            words = ("bullet", "indent", "numbering", "heading", "style", "align", "renumber", "checkbox", "spacing", "merge", prop.lower()) + tuple(w for ws in STYLE_WORDS.values() for w in ws)
            if mentions(request + " " + allowed, words):
                return "expected"
            return "unexpected"
        return "expected"
    if "renumber" in allowed and (".bullet" in p or "/lists" in p):
        return "allowed"
    if "lists map" in allowed and "/lists" in p:
        return "allowed"
    return "unexpected"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("before")
    ap.add_argument("after")
    ap.add_argument("--task", help="tasks.md#slug")
    ap.add_argument("--out")
    a = ap.parse_args()
    bdir, adir = Path(a.before), Path(a.after)
    out = Path(a.out) if a.out else adir.parent
    task = parse_task(a.task)
    in_target = target_matcher(task)

    bs = canonicalise(normalise(load(bdir / "structure.json")))
    as_ = canonicalise(normalise(load(adir / "structure.json")))
    lb, pb = flatten(bs)
    la, pa = flatten(as_)
    items = diff_leaves(lb, la) + compare_paragraphs(pb, pa)

    # comments
    def comments(d):
        j = load(d / "comments.json") if (d / "comments.json").exists() else {}
        cs = j.get("comments", j if isinstance(j, list) else [])
        return {f"comments[{c.get('id')}]": normalise({k: v for k, v in c.items() if k != "htmlContent"}) for c in cs}
    cb, ca = comments(bdir), comments(adir)
    for k in sorted(set(cb) | set(ca)):
        if cb.get(k) != ca.get(k):
            items.append({"path": k, "before": cb.get(k, "∅"), "after": ca.get(k, "∅")})

    for it in items:
        it["class"] = classify(it, in_target, task)
        it["visible"] = not INVISIBLE_RE.search(it["path"])
        it["needs_visual_review"] = any(s in it["path"] for s in ("dateElement", "richLink", "person", "suggestedInsertionIds", "suggestedDeletionIds", "inlineObject"))

    cat_b = (bdir / "cat.md").read_text().splitlines() if (bdir / "cat.md").exists() else []
    cat_a = (adir / "cat.md").read_text().splitlines() if (adir / "cat.md").exists() else []
    cat_diff = "\n".join(difflib.unified_diff(cat_b, cat_a, "before/cat.md", "after/cat.md", lineterm="", n=1))

    summary = {c: sum(1 for i in items if i["class"] == c) for c in ("expected", "allowed", "unexpected")}
    summary["visible_unexpected"] = sum(1 for i in items if i["class"] == "unexpected" and i["visible"])
    summary["invisible_unexpected"] = summary["unexpected"] - summary["visible_unexpected"]
    result = {"task": task["slug"] if task else None, "items": items, "cat_diff": cat_diff,
              "needs_visual_review_reasons": [i["path"] for i in items if i["needs_visual_review"]],
              "summary": summary}
    out.mkdir(parents=True, exist_ok=True)
    (out / "diff.json").write_text(json.dumps(result, indent=1, ensure_ascii=False, default=str))

    md = [f"# diff — {result['task'] or '(no task)'}", "",
          f"expected {summary['expected']} · allowed {summary['allowed']} · unexpected {summary['unexpected']} "
          f"(visible {summary['visible_unexpected']}, invisible {summary['invisible_unexpected']})", ""]
    for it in items:
        flag = "" if it["visible"] else " (invisible)"
        md.append(f"- **{it['class']}**{flag} `{it['path']}`")
        md.append(f"  - before: `{json.dumps(it['before'], ensure_ascii=False, default=str)[:200]}`")
        md.append(f"  - after:  `{json.dumps(it['after'], ensure_ascii=False, default=str)[:200]}`")
    md += ["", "## cat.md", "", "```diff", cat_diff or "(identical)", "```"]
    (out / "diff.md").write_text("\n".join(md) + "\n")
    print(f"expected={summary['expected']} allowed={summary['allowed']} unexpected={summary['unexpected']} -> {out/'diff.md'}")


if __name__ == "__main__":
    main()
