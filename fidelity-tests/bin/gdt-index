#!/usr/bin/env python3
"""gdt-index — regenerate fidelity-tests/INDEX.md from fixture.md, tasks.md and every
runs/*/verdict.md. Run from anywhere."""
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUTCOMES = ("DONE", "DECLINED-API", "GAP-CLI", "FAIL-AGENT", "COLLATERAL", "INVALID")


def front(path):
    t = path.read_text()
    m = re.match(r"^---\n(.*?)\n---", t, re.S)
    d = {}
    if m:
        for line in m.group(1).splitlines():
            if ":" in line and not line.startswith(" "):
                k, v = line.split(":", 1)
                d[k.strip()] = v.split("#")[0].strip()
    return d


def rates(verdicts, track):
    vs = [v for v in verdicts if v.get("track") == track and v.get("outcome") != "INVALID"]
    if not vs:
        return "–", "–"
    done = sum(1 for v in vs if v["outcome"] == "DONE")
    coll = sum(1 for v in vs if v["outcome"] == "COLLATERAL")
    return f"{done}/{len(vs)}", f"{len(vs)-coll}/{len(vs)}"


rows = []
run_rows = []
for fx in sorted(ROOT.glob("*/v*/fixture.md")):
    fdir = fx.parent
    name = f"{fdir.parent.name}/{fdir.name}"
    meta = dict(re.findall(r"^(\w+): (.*)$", fx.read_text(), re.M))
    tasks = re.findall(r"^## (\S+)", (fdir / "tasks.md").read_text(), re.M) if (fdir / "tasks.md").exists() else []
    verdicts = []
    for vpath in sorted(fdir.glob("runs/*/verdict.md")):
        v = front(vpath); verdicts.append(v)
        cid = v.get("copy_id", "")
        link = f"[copy](https://docs.google.com/document/d/{cid}/edit)" if cid and len(cid) > 20 else "–"
        run_rows.append(f"| {name} | {v.get('task','?')} | {v.get('track','?')} | {v.get('date','')} | **{v.get('outcome','?')}** | {link} | `{vpath.relative_to(ROOT).parent}` |")
    valid = [v for v in verdicts if v.get("outcome") != "INVALID"]
    latest = {}
    for v in verdicts:
        latest[(v.get("task"), v.get("track"))] = v.get("outcome")
    latest_s = ", ".join(f"{t}[{tr[0] if tr else '?'}]={o}" for (t, tr), o in sorted(latest.items(), key=lambda x: (x[0][0] or "", x[0][1] or ""))) or "–"
    ac, asf = rates(verdicts, "agent")
    cc, csf = rates(verdicts, "command")
    frozen = meta.get("frozen_revision_id", "?")
    updated = max([v.get("date", "") for v in verdicts] + [meta.get("created", "")])
    rows.append(f"| {name} | [doc]({meta.get('doc','')}) | {len(tasks)} | {len(valid)}/{len(verdicts)-len(valid)} | "
                f"{ac} / {asf} | {cc} / {csf} | {latest_s} | {updated} |")

text = """# gdoc fidelity tests — index

One row per fixture. Regenerated by `bin/gdt-index`; do not edit by hand. Rates are
DONE/valid (completion) and non-COLLATERAL/valid (safety), per track; see the skill's
`references/verdict.md`. Latest outcomes are per task, `[a]` agent track, `[c]` command.

| Fixture | Doc | Tasks | Runs valid/invalid | Agent compl. / safety | Command compl. / safety | Latest outcomes | Updated |
|---|---|---|---|---|---|---|---|
""" + "\n".join(rows) + """

## Runs

| Fixture | Task | Track | Date | Outcome | Doc | Files |
|---|---|---|---|---|---|---|
""" + "\n".join(run_rows) + "\n"
(ROOT / "INDEX.md").write_text(text)
print(text)
