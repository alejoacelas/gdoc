{"title":"gdt-text-v01 batch 20260903","revisionId":"ANLCKQk4eHnhIFYcr0K2QoV6afC-FcvyT9d2PI0o1YzWWDU6YIUzAkbRERFlooKgGOGOoC3Ki68XQboDD8o-THlUjhgBjARO1NNrJO0dlH8","suggestionsViewMode":"SUGGESTIONS_INLINE","documentId":"1dzI_lcHqKgetVer2YVs0kS0t_2ALWmv0Vh3YHlA8X-4","tabs":[{"tabProperties":{"tabId":"t.0","title":"Tab 1","index":0},"documentTab":{"body":{"content":[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSeparatorStyle":"NONE","contentDirection":"LEFT_TO_RIGHT","sectionType":"CONTINUOUS"}}},{"startIndex":1,"endIndex":56,"paragraph":{"elements":[{"startIndex":1,"endIndex":56,"textRun":{"content":"Northstar 2.1 release window \u2014 announcement draft (v3)\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.h8p2iegzr8wc","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":56,"endIndex":94,"paragraph":{"elements":[{"startIndex":56,"endIndex":94,"textRun":{"content":"Owner:\tMarta Kowalczyk\tStatus:\tDRAFT \n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":94,"endIndex":102,"paragraph":{"elements":[{"startIndex":94,"endIndex":102,"textRun":{"content":"Summary\n","textStyle":{"bold":true,"fontSize":{"magnitude":14,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":102,"endIndex":123,"paragraph":{"elements":[{"startIndex":102,"endIndex":123,"textRun":{"content":"What we are shipping\n","textStyle":{"bold":true,"underline":true}}}],"paragraphStyle":{"headingId":"h.1x7abc6lswku","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":123,"endIndex":144,"paragraph":{"elements":[{"startIndex":123,"endIndex":144,"textRun":{"content":"Key dates and labels\n","textStyle":{"bold":true}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":144,"endIndex":380,"paragraph":{"elements":[{"startIndex":144,"endIndex":380,"textRun":{"content":"The release window opens 15\u201319 Sept 2026, not 14\u201318 Sept as the v2 draft said and not 14\u201418 Sept as the CMS rendered it. Legal signed off on Tuesday; Marta wants the \u201cbeta\u201d label gone and the \"preview\" badge hidden in the same release.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":380,"endIndex":608,"paragraph":{"elements":[{"startIndex":380,"endIndex":504,"textRun":{"content":"Ana\u2019s note: the release window is not the same thing as the Launch Window banner in the app; the banner string lives in the ","textStyle":{}}},{"startIndex":504,"endIndex":521,"textRun":{"content":"release checklist","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://example.com/northstar/checklist"}}}},{"startIndex":521,"endIndex":559,"textRun":{"content":" and is owned by design. See also the ","textStyle":{}}},{"startIndex":559,"endIndex":577,"textRun":{"content":"release window FAQ","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://example.com/northstar/faq"}}}},{"startIndex":577,"endIndex":608,"textRun":{"content":" before replying to customers.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":608,"endIndex":766,"paragraph":{"elements":[{"startIndex":608,"endIndex":711,"textRun":{"content":"If anything slips, the release window moves as a whole; we do not ship half the features. Live status: ","textStyle":{}}},{"startIndex":711,"endIndex":747,"textRun":{"content":"https://status.example.com/northstar","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://status.example.com/northstar"}}}},{"startIndex":747,"endIndex":766,"textRun":{"content":" (updated hourly).\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":766,"endIndex":792,"paragraph":{"elements":[{"startIndex":766,"endIndex":792,"textRun":{"content":"Copy for the announcement\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.byuqhsf8tc6o","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":792,"endIndex":1112,"paragraph":{"elements":[{"startIndex":792,"endIndex":840,"textRun":{"content":"Northstar 2.2 is the biggest release since 1.0: ","textStyle":{}}},{"startIndex":840,"endIndex":860,"textRun":{"content":"release-notes-2.1.md","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"http://release-notes-2.1.md"}}}},{"startIndex":860,"endIndex":1112,"textRun":{"content":" (more soon...) as Marta put it in #launch, \u201cwe finally fixed the sync bug that ate everyone\u2019s Tuesday afternoon\u201d and the landing-page draft says Faster sync. Fewer surprises. More soon\u2026 (Tom\u00e1s pasted that last bit from the web page, hence the fonts.)\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":1112,"endIndex":1350,"paragraph":{"elements":[{"startIndex":1112,"endIndex":1143,"textRun":{"content":"The formula card still reads CO","textStyle":{}}},{"startIndex":1143,"endIndex":1144,"textRun":{"content":"2","textStyle":{"baselineOffset":"SUBSCRIPT"}}},{"startIndex":1144,"endIndex":1150,"textRun":{"content":" and x","textStyle":{}}},{"startIndex":1150,"endIndex":1151,"textRun":{"content":"2","textStyle":{"baselineOffset":"SUPERSCRIPT"}}},{"startIndex":1151,"endIndex":1231,"textRun":{"content":", the old deck typed its footnote marker as [1] instead of using a real footnote","textStyle":{}}},{"startIndex":1231,"endIndex":1232,"footnoteReference":{"footnoteId":"kix.dy0afxbtah37","footnoteNumber":"1","textStyle":{}}},{"startIndex":1232,"endIndex":1350,"textRun":{"con