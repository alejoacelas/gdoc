201319 Sept 2026, not 14\u201318 Sept as the v2 draft said and not 14\u201418 Sept as the CMS rendered it. Legal signed off on Tuesday; Marta wants the \u201cbeta\u201d label gone and the \"preview\" badge hidden in the same release.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":378,"endIndex":604,"paragraph":{"elements":[{"startIndex":378,"endIndex":501,"textRun":{"content":"Ana\u2019s note: the launch window is not the same thing as the Launch Window banner in the app; the banner string lives in the ","textStyle":{}}},{"startIndex":501,"endIndex":518,"textRun":{"content":"release checklist","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://example.com/northstar/checklist"}}}},{"startIndex":518,"endIndex":556,"textRun":{"content":" and is owned by design. See also the ","textStyle":{}}},{"startIndex":556,"endIndex":573,"textRun":{"content":"launch window FAQ","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://example.com/northstar/faq"}}}},{"startIndex":573,"endIndex":604,"textRun":{"content":" before replying to customers.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":604,"endIndex":761,"paragraph":{"elements":[{"startIndex":604,"endIndex":706,"textRun":{"content":"If anything slips, the launch window moves as a whole; we do not ship half the features. Live status: ","textStyle":{}}},{"startIndex":706,"endIndex":742,"textRun":{"content":"https://status.example.com/northstar","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://status.example.com/northstar"}}}},{"startIndex":742,"endIndex":761,"textRun":{"content":" (updated hourly).\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":761,"endIndex":787,"paragraph":{"elements":[{"startIndex":761,"endIndex":787,"textRun":{"content":"Copy for the announcement\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.byuqhsf8tc6o","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":787,"endIndex":1107,"paragraph":{"elements":[{"startIndex":787,"endIndex":835,"textRun":{"content":"Northstar 2.2 is the biggest release since 1.0: ","textStyle":{}}},{"startIndex":835,"endIndex":855,"textRun":{"content":"release-notes-2.1.md","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"http://release-notes-2.1.md"}}}},{"startIndex":855,"endIndex":1107,"textRun":{"content":" (more soon...) as Marta put it in #launch, \u201cwe finally fixed the sync bug that ate everyone\u2019s Tuesday afternoon\u201d and the landing-page draft says Faster sync. Fewer surprises. More soon\u2026 (Tom\u00e1s pasted that last bit from the web page, hence the fonts.)\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":1107,"endIndex":1345,"paragraph":{"elements":[{"startIndex":1107,"endIndex":1138,"textRun":{"content":"The formula card still reads CO","textStyle":{}}},{"startIndex":1138,"endIndex":1139,"textRun":{"content":"2","textStyle":{"baselineOffset":"SUBSCRIPT"}}},{"startIndex":1139,"endIndex":1145,"textRun":{"content":" and x","textStyle":{}}},{"startIndex":1145,"endIndex":1146,"textRun":{"content":"2","textStyle":{"baselineOffset":"SUPERSCRIPT"}}},{"startIndex":1146,"endIndex":1226,"textRun":{"content":", the old deck typed its footnote marker as [1] instead of using a real footnote","textStyle":{}}},{"startIndex":1226,"endIndex":1227,"footnoteReference":{"footnoteId":"kix.dy0afxbtah37","footnoteNumber":"1","textStyle":{}}},{"startIndex":1227,"endIndex":1345,"textRun":{"content"