Run":{"content":"The launch window opens 14\u201318 Sept 2026, not 14-18 Sept as the v2 draft said and not 14\u201418 Sept as the CMS rendered it. Legal signed off on Tuesday; Marta wants the \u201cbeta\u201d label gone and the \"beta\" badge hidden in the same release.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":363,"endIndex":589,"paragraph":{"elements":[{"startIndex":363,"endIndex":486,"textRun":{"content":"Ana\u2019s note: the launch window is not the same thing as the Launch Window banner in the app; the banner string lives in the ","textStyle":{}}},{"startIndex":486,"endIndex":503,"textRun":{"content":"release checklist","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://example.com/northstar/checklist"}}}},{"startIndex":503,"endIndex":541,"textRun":{"content":" and is owned by design. See also the ","textStyle":{}}},{"startIndex":541,"endIndex":558,"textRun":{"content":"launch window FAQ","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://example.com/northstar/faq"}}}},{"startIndex":558,"endIndex":589,"textRun":{"content":" before replying to customers.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":589,"endIndex":746,"paragraph":{"elements":[{"startIndex":589,"endIndex":691,"textRun":{"content":"If anything slips, the launch window moves as a whole; we do not ship half the features. Live status: ","textStyle":{}}},{"startIndex":691,"endIndex":727,"textRun":{"content":"https://status.example.com/northstar","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://status.example.com/northstar"}}}},{"startIndex":727,"endIndex":746,"textRun":{"content":" (updated hourly).\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":746,"endIndex":772,"paragraph":{"elements":[{"startIndex":746,"endIndex":772,"textRun":{"content":"Copy for the announcement\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.byuqhsf8tc6o","namedStyleType":"HEADING_2","direction":"LEFT_TO_RIGHT"}}},{"startIndex":772,"endIndex":1082,"paragraph":{"elements":[{"startIndex":772,"endIndex":820,"textRun":{"content":"Northstar 2.1 is the biggest release since 1.0: ","textStyle":{}}},{"startIndex":820,"endIndex":840,"textRun":{"content":"release-notes-2.1.md","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"fontSize":{"magnitude":9,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Courier New","weight":400},"link":{"url":"http://release-notes-2.1.md"}}}},{"startIndex":840,"endIndex":856,"textRun":{"content":" (more soon...) ","textStyle":{"fontSize":{"magnitude":9,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Courier New","weight":400}}}},{"startIndex":856,"endIndex":944,"textRun":{"content":"as Marta put it in #launch, \u201cwe finally fixed the sync bug that ate everyone\u2019s Tuesday\u201d ","textStyle":{"fontSize":{"magnitude":13,"unit":"PT"},"weightedFontFamily":{"fontFamily":"Georgia","weight":400}}}},{"startIndex":944,"endIndex":1017,"textRun":{"content":"and the landing-page draft says Faster sync. Fewer surprises. More soon\u2026 ","textStyle":{"weightedFontFamily":{"fontFamily":"Times New Roman","weight":400}}}},{"startIndex":1017,"endIndex":1082,"textRun":{"content":"(Tom\u00e1s pasted that last bit from the web page, hence the fonts.)\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","direction":"LEFT_TO_RIGHT"}}},{"startIndex":1082,"endIndex":1320,"paragraph":{"elements":[{"startIndex":1082,"endIndex":1112,"textRun":{"content":"The formula card still reads H","textSt